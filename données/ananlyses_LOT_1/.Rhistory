# bottom (Z1)
# top of the trunk (Z2–Z3)
# the heart (Z4)
# the periphery of the canopy (Z5-Z6)
MC_TEMP$top_trunk <- rowMeans(MC_TEMP[, c("T_ZONE2", "T_ZONE3")], na.rm = TRUE)
