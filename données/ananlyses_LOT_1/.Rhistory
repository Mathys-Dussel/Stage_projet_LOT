#| label: bray-curtis-Jaccard-distance
library(vegan)
otu_table <- as(otu_table(ps), "matrix")
bray_dist <- vegdist(otu_table, method = "bray")
jaccard_dist <- vegdist(otu_table > 0, method = "jaccard")
#| label: ordination-nmds-globales
ps_hellinger <- transform_sample_counts(ps, function(x) sqrt(x / sum(x)))
nmds_bray <- ordinate(ps_hellinger, method = "NMDS", distance = "bray")
plot_ordination(ps_hellinger, nmds_bray, color = "organ", shape = "position") +
geom_point(size = 3, alpha = 0.8) +
theme_bw() +
labs(title = "NMDS - Bray-Curtis (Hellinger)")
plot_ordination(ps_hellinger, nmds_bray, color = "organ", shape = "project") +
geom_point(size = 3, alpha = 0.8) +
theme_bw() +
labs(title = "NMDS - Bray-Curtis")
plot_ordination(ps_hellinger, nmds_bray, color = "project") +
geom_point(aes(shape = organ), size = 3, alpha = 0.8) +
theme_bw() +
stat_ellipse(aes(group = project)) +
labs(title = "NMDS - Bray-Curtis")
plot_ordination(ps_hellinger, nmds_bray, color = "plant_", shape = "project") +
geom_point(size = 3, alpha = 0.8) +
theme_bw() +
labs(title = "NMDS - Bray-Curtis")
