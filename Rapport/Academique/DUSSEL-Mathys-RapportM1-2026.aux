\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Courbes de raréfaction et d'extrapolation pour la diversité alpha (q=0 : richesse spécifique, q=1 : diversité de Shannon exponentielle et q=2 : diversité de Simpson inverse) des communautés fongiques associées aux plantes épiphytes. Les courbes sont présentées pour différents organes (feuilles jeunes, feuilles vieilles, racines) ou différents sites (LOT1, LOT2 ou LOT3). Les intervalles de confiance à 95\% sont indiqués par des zones ombrées.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:inext}{{2}{4}{Courbes de raréfaction et d'extrapolation pour la diversité alpha (q=0 : richesse spécifique, q=1 : diversité de Shannon exponentielle et q=2 : diversité de Simpson inverse) des communautés fongiques associées aux plantes épiphytes. Les courbes sont présentées pour différents organes (feuilles jeunes, feuilles vieilles, racines) ou différents sites (LOT1, LOT2 ou LOT3). Les intervalles de confiance à 95\% sont indiqués par des zones ombrées}{figure.2}{}}
