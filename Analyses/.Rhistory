library(phyloseq)
ps <- readRDS("~/Documents/Etudes/Stage_projet_LOT/CRBE/Analyses/donnees/ps_final.rds")
ps_trim <- filter_taxa(ps, function(x) sum(x) > 99, TRUE)
ps_merged <- merge_samples(ps_trim, "organ")
otu_tab <- as.matrix(t(otu_table(ps_merged)))
otu_num <- apply(otu_tab, 2, function(x) as.numeric(as.character(x)))
otu_num[is.na(otu_num)] <- 0
rownames(otu_num) <- taxa_names(ps_merged)
otu_grouped <- as.data.frame(otu_num)
class(otu_grouped)
dim(otu_grouped)
str(otu_grouped[, 1:3])
sum(is.na(otu_grouped))
summary(otu_grouped)
library(vegan)
library(ggplot2)
# 1. Préparation de la matrice (Transposée car vegan veut les échantillons en lignes)
# On s'assure que c'est une matrice d'entiers pure
mat_final <- as.matrix(otu_grouped)
mat_vegan <- t(mat_final)
# 2. Calcul analytique (instantané)
# tidy = TRUE transforme le résultat en tableau pour ggplot
print("Calcul en cours...")
rare_data <- rarecurve(mat_vegan, step = 500, tidy = TRUE)
# 3. Graphique
ggplot(rare_data, aes(x = Sample, y = Species, color = Site)) +
geom_line(linewidth = 1) +
labs(title = "Courbes de raréfaction (Moteur Vegan)",
