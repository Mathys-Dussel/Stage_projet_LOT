knitr::opts_chunk$set(echo = TRUE)
m1 <- lm(biomass ~ -1 + days/year_to_1989,data=d.biomass,x=TRUE)
knitr::opts_chunk$set(echo = TRUE)
show_correction=TRUE
rm(list=ls())
d.biomass  <- read.table("journal.pone.0185809.s004.csv",header=T,sep=",")
d.biomass <- subset(d.biomass,!is.na(biomass))
d.biomass$month <- factor(gsub("^.*-","",d.biomass$from)) ## mois de l'observation
d.biomass$location.type <- factor(d.biomass$location.type)
d.biomass$biomass.per.day <- with(d.biomass,biomass/(to.daynr-from.daynr))
d.biomass$year_to_1989 <- d.biomass$year - 1989
d.biomass$days <- with(d.biomass,to.daynr-from.daynr)
library(lmtest)
library(car)
layout(matrix(1:2,ncol=2))
plot(biomass~year,
data=d.biomass)
plot(biomass~days,
data=subset(d.biomass,year %in% c(1989,2014)),
col=ifelse(year>2000,"red","blue"))
legend("topright",fill=c("blue","red"),legend=c(1989,2014))
plot(biomass.per.day~jitter(year,factor=2),
pch=21,bg= adjustcolor(c("blue","green","grey")[location.type],alpha.f=0.5),
data=d.biomass)
m1=lm(biomass~ days*year_to_1989 , data=d.biomass)
m1=lm(biomass~ -1 + days/year_to_1989 , data=d.biomass)
# Yij= a + b*days + c*yt89 + d*days*yt89 + eij
m1 <- lm(biomass ~ -1 + days/year_to_1989,data=d.biomass,x=TRUE)
#m1$x
m1 <- lm(biomass ~ -1 + days/year_to_1989,data=d.biomass,x=TRUE)
## prédiction pour 1989 (avec intervale de confiance autour de la prédiction)
dtmp0 <- data.frame(year_to_1989=0,days=seq(0,25,length=25))
dtmp0 <- cbind(dtmp0,predict(m1,newdata=dtmp0,interval="confidence"))
dtmp27 <- data.frame(year_to_1989=27,days=seq(0,25,length=25))
dtmp27 <- cbind(dtmp27,predict(m1,newdata=dtmp27,interval="confidence"))
## graphique
plot(fit~days,data=dtmp0,type="l",col=c("red"))
lines(lwr~days,data=dtmp0,type="l",lty=2,col=c("red"))
lines(upr~days,data=dtmp0,type="l",lty=2,col=c("red"))
lines(lwr~days,data=dtmp27,type="l",lty=2,col=c("blue"))
lines(upr~days,data=dtmp27,type="l",lty=2,col=c("blue"))
lines(fit~days,data=dtmp27,type="l",col=c("blue"))
X <- m1$x
Y <- d.biomass$biomass
theta.chapeau <- solve(t(X)%*%X)%*%t(X)%*%Y
summary(m1)
Y.chapeau <- X%*%theta.chapeau
e <- Y - Y.chapeau
CMR <- sum(e^2)/(length(Y)-length(theta.chapeau))
Xprime <- cbind(dtmp0$days,dtmp0$days*dtmp0$year_to_1989)
Yprime.chapeau <- Xprime%*%theta.chapeau
Sigma_Yprime.chapeau <- Xprime%*% solve(t(X)%*%X) %*% t(Xprime) * CMR
Sigma_Yprime.chapeau[1:5,1:5]
## la variance des prédictions en fonction du nombre du jours de piégeage
plot(dtmp0$days,diag(Sigma_Yprime.chapeau),type="b")
## attention : la variance augmente ici quand on s'éloigne de zéro,
## mais c'est parce que le modèle ne contient pas d'intercept! Dans
## une régression linéaire "classique" la variance augmente quand x_i
## s'écarte de la moyenne des x_i.
## quantile à 2.5% d'une Student à n-p ddl
t.seuil <- -qt(0.025,df=m1$df.residual)
## à noter ici qu'on utilise une Student parce que cela
## permet de prendre en compte l'incertitude sur l'estimation
## de la variance résiduelle. Si on considérait cette variance
## comme connue, on utiliserait à la place une normale centrée
## réduite. Dans notre cas, parce que n-p est grand, le seuil
## ne serait pas très différent (1.959964 au lieu  de 1.961546).
## écart aux bornes de l'intervalle de confiance
delta <- t.seuil*sqrt(diag(Sigma_Yprime.chapeau))
## on retrouve bien les résultats précédents (calculés ici pour year_to_1989=27)
plot(Xprime[,1],Yprime.chapeau,type="l",lwd=2)
l <- nrow(dtmp0):1
x.IC <- c(Xprime[,1],Xprime[l,1])
y.IC <- c(Yprime.chapeau+delta,    ## borne sup
Yprime.chapeau[l]-delta[l]) ## borne inf
polygon(x.IC,y.IC,col=adjustcolor("indianred",alpha.f=0.2),border = NA)
## on utilise la matrice X précédemment extraite du modèle
head(X)
## calcul de la matrice chapeau
H <- X%*%solve(t(X)%*%X)%*%t(X)
H[1:5,1:5]
plot(m1)
shapiro.test(residuals(m1))
bptest(m1)
plot(X[,1],diag(H))
## comme il n'y a pas d'intercept, le levier est d'autant
## plus grand qu'on s'éloigne de zéro
plot(X[,2],diag(H))
abline(v=mean(X[,2]))
## ici le levier est d'autant plus grand que le produit
## année*jours est éloigné de sa moyenne
## illustration du problème par deux simulations
## illustration 1 (une variable explicative)
x <- factor(rep(1:2,each=20))
y <- as.numeric(x)*4 + rnorm(length(x))
m0 <- lm(y~1) ## on ne prend pas en compte l'effet x
plot(m0,which=1)
## illustration 2 (deux variables explicatives)
A <- factor(rep(1:2,each=40))
B <- factor(rep(1:2,40))
y <- as.numeric(A)*(as.numeric(B)+1)*4 + rnorm(length(A))
m0  <- lm(y~1);   plot(m0,which=1)
m1a <- lm(y~A);   plot(m1a,which=1)
m1b <- lm(y~B);   plot(m1b,which=1)
m2  <- lm(y~A+B); plot(m2,which=1)
m3  <- lm(y~A*B); plot(m3,which=1)
## illustration par des simulations des deux dernières stratégies:
## trois modèles où la relation entre x et y est exponentielle
x <- rep(1:5, each = 10)
e <- rnorm(length(x))
layout(matrix(1:3,ncol=3))
# cas 1
y <- 1+2*exp(x) + e
plot(y~x)
# cas 2
logy <- 1+2*x + e
y <- exp(logy)
plot(y~x)
# cas 3
logy <- 1+2*log(x) + e
y <- exp(logy)
plot(y~x)
y <- seq(0,2,length=100)
f.boxcox <- function(z,lambda=1) {
if(lambda==0) return(log(y))
(y^lambda-1)/lambda
}
plot(y,f.boxcox(y),type="n")
for(lambda in seq(-2,2,by=0.25))
lines(y,f.boxcox(y,lambda),
lty=ifelse(lambda %in% c(0,1),2,1),
col=ifelse(lambda<0,"red",ifelse(lambda>1,"blue","black")))
abline(v=1,col="gray",lty=3)
abline(h=0,col="gray",lty=3)
