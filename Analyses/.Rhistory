library(phyloseq)
library(ggplot2)
library(ggpubr)
library(patchwork)
ps <- readRDS("donnees_nettoyees.rds")
sample_names(ps) <- gsub("\\.", "-", sub("^X", "", sample_names(ps)))
familles_a_enlever <- c("Moraceae", "Fabaceae")
ps <- subset_samples(ps, !plant_family %in% familles_a_enlever)
ps <- prune_taxa(taxa_sums(ps) > 0, ps)
ps@tax_table
