library(phyloseq)
library(ggplot2)
library(patchwork)
phyloseq_lot <- readRDS("donnees_nettoyees.rds")
div_alpha <- estimate_richness(phyloseq_lot,
measures = c("Observed", "Chao1", "Shannon", "Simpson"))
rownames(div_alpha) <- sub("^X", "", rownames(div_alpha))
rownames(div_alpha) <- gsub("\\.", "-", rownames(div_alpha))
metadonnees <- data.frame(sample_data(phyloseq_lot), check.names = FALSE)
rownames(metadonnees) <- gsub("\\.", "-", rownames(metadonnees))
df_div_alpha <- merge(div_alpha, metadonnees, by = 0, all.x = TRUE)
colnames(df_div_alpha)[1] <- "sample"
# sample, observed, chao1, shannon, simpson, organ, position, plant_family, plant_genus, plant_species, project
variables <- c("Row.names", "Observed", "Chao1", "Shannon",     "Simpson","organ", "position", "plant_family", "plant_genus", "plant_species", "project")
df_div_alpha <- df_div_alpha[, intersect(colnames(df_div_alpha), variables)]
df_div_alpha$expShannon <- exp(df_div_alpha$Shannon)
df_div_alpha$invSimpson <- 1/df_div_alpha$Simpson
