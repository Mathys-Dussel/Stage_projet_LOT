ps <- readRDS("donnees_nettoyees.rds")
sample_names(ps) <- gsub("\\.", "-", sub("^X", "", sample_names(ps)))
ps_LOT1 <- subset_samples(ps, startsWith(LOT_sampleID, "LOT01"))
ps_LOT1 <- prune_taxa(taxa_sums(ps_LOT1) > 0, ps_LOT1)
ps_LOT1_BOT <- subset_samples(ps_LOT1, substr(LOT_sampleID, 9, 9) == "1")
ps_LOT1_BOT <- prune_taxa(taxa_sums(ps_LOT1_BOT) > 0, ps_LOT1_BOT)
ps_LOT1_HEART <- subset_samples(ps_LOT1, substr(LOT_sampleID, 9, 9) == "4")
ps_LOT1_HEART <- prune_taxa(taxa_sums(ps_LOT1_HEART) > 0, ps_LOT1_HEART)
ps_LOT1_TOP <- subset_samples(ps_LOT1, substr(LOT_sampleID, 9, 9) %in% c("2", "3"))
ps_LOT1_TOP <- prune_taxa(taxa_sums(ps_LOT1_TOP) > 0, ps_LOT1_TOP)
ps_LOT1_PERIPH <- subset_samples(ps_LOT1, substr(LOT_sampleID, 9, 9) %in% c("5", "6"))
ps_LOT1_PERIPH <- prune_taxa(taxa_sums(ps_LOT1_PERIPH) > 0, ps_LOT1_PERIPH)
View(ps_LOT1_BOT)
ps_LOT1_BOT@sam_data[["LOT_sampleID"]]
View(ps_LOT1_HEART)
